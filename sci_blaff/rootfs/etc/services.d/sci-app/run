#!/usr/bin/with-contenv bashio
# ==============================================================================
# Démarre le serveur SCI BLAFF (Node.js)
# ==============================================================================

ADMIN_EMAIL=$(bashio::config 'admin_email')
ADMIN_PASSWORD=$(bashio::config 'admin_password')
ADMIN_NAME=$(bashio::config 'admin_name')
DOMAIN=$(bashio::config 'domain')
EXPORT_API_KEY=$(bashio::config 'export_api_key')
GOOGLE_CLIENT_ID=$(bashio::config 'google_client_id')
GOOGLE_CLIENT_SECRET=$(bashio::config 'google_client_secret')
GOOGLE_DRIVE_FOLDER_ID=$(bashio::config 'google_drive_folder_id')

if bashio::config.is_empty 'admin_email' || bashio::config.is_empty 'admin_password'; then
    bashio::log.warning "Options 'admin_email' / 'admin_password' non renseignées."
    bashio::log.warning "Configure-les dans l'onglet Configuration de l'add-on, puis redémarre."
fi

export DATA_DIR=/data
export PORT=3000
export ADMIN_EMAIL
export ADMIN_PASSWORD
export ADMIN_NAME
export DOMAIN
export EXPORT_API_KEY
export GOOGLE_CLIENT_ID
export GOOGLE_CLIENT_SECRET
export GOOGLE_DRIVE_FOLDER_ID

bashio::log.info "Démarrage du serveur SCI BLAFF sur le port interne 3000…"
cd /app || bashio::exit.nok "Impossible d'accéder à /app"
exec node server.js
